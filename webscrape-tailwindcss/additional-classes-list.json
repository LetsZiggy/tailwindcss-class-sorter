{
	"3rd-party": {
		"tailwindcss-container-queries": {
			"links": ["https://github.com/tailwindlabs/tailwindcss-container-queries"],
			"regular": ["@container", "@container-normal"],
			"custom": []
		},
		"tailwindcss-forms": {
			"links": ["https://github.com/tailwindlabs/tailwindcss-forms"],
			"regular": ["form-input", "form-textarea", "form-select", "form-multiselect", "form-checkbox", "form-radio"],
			"custom": []
		},
		"tailwindcss-typography": {
			"links": ["https://github.com/tailwindlabs/tailwindcss-typography"],
			"regular": [
				"prose",
				"not-prose",
				"prose-invert",
				"prose-sm",
				"prose-base",
				"prose-lg",
				"prose-xl",
				"prose-2xl",
				"prose-gray",
				"prose-slate",
				"prose-zinc",
				"prose-neutral",
				"prose-stone"
			],
			"custom": []
		}
	},
	"deprecated": {
		"background-position": {
			"links": [
				"https://github.com/tailwindlabs/tailwindcss/pull/17378",
				"https://tailwindcss.com/docs/background-position"
			],
			"regular": ["bg-left-bottom", "bg-left-top", "bg-right-bottom", "bg-right-top"],
			"custom": []
		},
		"object-position": {
			"links": [
				"https://github.com/tailwindlabs/tailwindcss/pull/17437",
				"https://tailwindcss.com/docs/object-position"
			],
			"regular": ["object-left-bottom", "object-left-top", "object-right-bottom", "object-right-top"],
			"custom": []
		},
		"order": {
			"links": ["https://github.com/tailwindlabs/tailwindcss/pull/18126", "https://tailwindcss.com/docs/order"],
			"regular": ["order-none"],
			"custom": []
		},
		"word-break": {
			"links": [
				"https://github.com/tailwindlabs/tailwindcss/pull/19157",
				"https://tailwindcss.com/docs/word-break",
				"https://tailwindcss.com/docs/overflow-wrap"
			],
			"regular": ["break-words"],
			"custom": []
		},
		"top-right-bottom-left": {
			"links": [
				"https://github.com/tailwindlabs/tailwindcss/pull/19623",
				"https://tailwindcss.com/docs/top-right-bottom-left"
			],
			"regular": [
				"start-5",
				"-start-5",
				"start-1/2",
				"-start-1/2",
				"start-px",
				"-start-px",
				"start-full",
				"-start-full",
				"start-auto",
				"end-5",
				"-end-5",
				"end-1/2",
				"-end-1/2",
				"end-px",
				"-end-px",
				"end-full",
				"-end-full",
				"end-auto"
			],
			"custom": ["start-(<custom-property>)", "start-[<value>]", "end-(<custom-property>)", "end-[<value>]"]
		}
